# Copie o .env para o arquivo .gitignore (na raiz do repositorio) e ajuste os valores antes de
# `docker compose up` (compose de raiz, unificado) ou de qualquer compose de infra/local/*
# subido isolado com `--env-file` apontando para este arquivo.
#
# Fonte unica: nao crie copias deste arquivo em apps/ nem em infra/local/*
# (ver change unificar-orquestracao-docker-local, D5). Variaveis ausentes causam erro
# explicito nomeando a variavel ausente.

DB_NAME=db-receiptsio
DB_PORT=5432
DB_USER_NAME=docker
DB_PASSWORD=<defina-sua-senha-superusuario>
DB_CATALOGO_LEITURA_PASSWORD=<defina-sua-senha-role-leitura>
DB_CATALOGO_ESCRITA_PASSWORD=<defina-sua-senha-role-escrita>
