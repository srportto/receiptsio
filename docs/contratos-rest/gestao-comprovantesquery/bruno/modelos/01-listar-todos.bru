meta {
  name: Listar todos (sem filtro)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/modelos
  body: none
  auth: none
}

params:query {
  ~situacao: ATIVO
  ~idModelo: {{idModelo}}
  ~versao: {{versao}}
  ~page: 1
  ~size: 20
}

tests {
  test("200 com items e pagination", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array");
    expect(res.body.pagination).to.have.all.keys("page", "size", "totalElements", "totalPages");
  });
}

docs {
  Sem filtro lista modelos em qualquer situação. Ative os parâmetros desabilitados (~) para filtrar.
}
